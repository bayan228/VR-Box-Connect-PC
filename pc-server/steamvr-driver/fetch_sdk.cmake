# OpenVR SDK 2.15.6, pinned to its release commit; only the driver header and license are needed.
set(OPENVR_COMMIT "0924064316de3effbcd1acf1e309182a2deb1c05")
set(OPENVR_ROOT "${CMAKE_CURRENT_LIST_DIR}/../third_party/openvr")
file(MAKE_DIRECTORY "${OPENVR_ROOT}/headers")
foreach(path IN ITEMS headers/openvr_driver.h LICENSE)
    if(NOT EXISTS "${OPENVR_ROOT}/${path}")
        file(DOWNLOAD "https://raw.githubusercontent.com/ValveSoftware/openvr/${OPENVR_COMMIT}/${path}"
            "${OPENVR_ROOT}/${path}" STATUS result TLS_VERIFY ON TIMEOUT 90 INACTIVITY_TIMEOUT 30)
        list(GET result 0 code)
        if(NOT code EQUAL 0)
            file(REMOVE "${OPENVR_ROOT}/${path}")
            message(FATAL_ERROR "Cannot fetch pinned OpenVR ${path}: ${result}")
        endif()
    endif()
    file(SHA256 "${OPENVR_ROOT}/${path}" digest)
    if(path STREQUAL "headers/openvr_driver.h")
        set(expected "1036efe998d63e82d1d3db2b32a2f58df4a8eeaf5280f50aaf28220ff60a40ab")
    else()
        set(expected "f56ff606104d4ef18e617921a75c73ad73b5a1a1d70c69590c29de16919e04ad")
    endif()
    if(NOT digest STREQUAL expected)
        message(FATAL_ERROR "OpenVR ${path} checksum mismatch")
    endif()
    message(STATUS "OpenVR ${path} SHA256 ${digest}")
endforeach()
